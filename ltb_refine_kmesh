#!/usr/bin/env python3
"""
Iteratively refine k-meshes using ltb_use_custom_kmesh based on df/da error.

Usage:
    ltb_refine_kmesh initial_hdf5 tb_file chemical_potential gamma_min t_min
                    [--error_tol ERR] [--max_iter N] [--refinement_factor F]
                    [--energy_window E] [--ltb_use_custom_kmesh PATH] [--filling FILL]
                    [--mushift] [--keep_intermediate] [--workdir DIR] [--verbose]

Positional arguments:
    initial_hdf5        Initial tight-binding HDF5 file (must end with .hdf5).
    tb_file             Wannier-style tight-binding input for ltb_use_custom_kmesh.
    chemical_potential  Chemical potential (mu) used for df/da and ltb_use_custom_kmesh.
    gamma_min           Minimum gamma parameter for df/da.
    t_min               Minimum temperature for df/da.

Optional arguments:
    --error_tol ERR         Target df/da error threshold (default: 0.005).
    --max_iter N            Maximum refinement iterations (default: 10).
    --refinement_factor F   Subdivisions per axis for refined hotspots (default: 4).
    --energy_window E       Initial mu-centered window to locate hotspots (default: 0.1).
    --ltb_use_custom_kmesh PATH       Path to ltb_use_custom_kmesh executable (auto-detects alongside this
                            script or on PATH when omitted).
    --filling FILL          Electron filling passed to ltb_use_custom_kmesh (default: 2.0).
    --mushift               Pass --mushift to ltb_use_custom_kmesh.
    --keep_intermediate     Keep intermediate meshes and outputs instead of overwriting.
    --workdir DIR           Directory to run ltb_use_custom_kmesh and store outputs (default: cwd).
    --verbose               Enable debug logging.
"""

from __future__ import annotations

import argparse
import logging
import os
import shutil
import subprocess
import sys
from pathlib import Path

import h5py
import numpy as np

from structure.meshrefine import (
    MissingDependencyError,
    BandData,
    build_band_axis,
    compute_error,
    detect_refinement_scale,
    load_band_data,
    refine_kmesh,
    write_custom_mesh,
)

LOG_FORMAT = "%(levelname)s: %(message)s"
logger = logging.getLogger("ltb_refine_kmesh")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)

    parser.add_argument("initial_hdf5", type=Path, help="Initial tight-binding HDF5 file (must end with .hdf5).")
    parser.add_argument("tb_file", type=Path, help="Wannier-style tight-binding input file for ltb_use_custom_kmesh.")

    parser.add_argument("chemical_potential", type=float, help="Chemical potential used for refinement and ltb_use_custom_kmesh.")
    parser.add_argument("gamma_min", type=float, help="Minimum gamma parameter for df/da.")
    parser.add_argument("t_min", type=float, help="Minimum temperature for df/da.")

    parser.add_argument("--error_tol", type=float, default=5e-3, help="Target error threshold. Default: 0.005.")
    parser.add_argument("--max_iter", type=int, default=10, help="Maximum refinement iterations. Default: 10.")
    parser.add_argument(
        "--refinement_factor", type=int, default=4, help="Subdivisions per axis for refined regions. Default: 4."
    )
    parser.add_argument(
        "--energy_window", type=float, default=0.1, help="Initial energy window around mu for hotspot detection."
    )
    parser.add_argument(
        "--ltb_use_custom_kmesh",
        type=Path,
        default=None,
        help="Path to ltb_use_custom_kmesh executable. Defaults to auto-discovery (script directory or PATH).",
    )
    parser.add_argument(
        "--filling", type=float, default=2.0, help="Electron filling passed to ltb_use_custom_kmesh (default: 2.0)."
    )
    parser.add_argument(
        "--mushift", action="store_true", help="Pass --mushift to ltb_use_custom_kmesh after each iteration."
    )

    parser.add_argument(
        "--keep_intermediate",
        action="store_true",
        help="Keep intermediate mesh and output files instead of overwriting them.",
    )

    parser.add_argument(
        "--workdir", type=Path, default=Path.cwd(), help="Directory where ltb_use_custom_kmesh will be executed."
    )

    parser.add_argument("--verbose", action="store_true", help="Increase logging verbosity.")

    return parser.parse_args(argv)


def validate_inputs(args: argparse.Namespace) -> None:
    if args.initial_hdf5.suffix.lower() != ".hdf5":
        raise ValueError("Initial file must be an HDF5 (.hdf5) file.")
    if not args.initial_hdf5.exists():
        raise FileNotFoundError(args.initial_hdf5)
    if not args.tb_file.exists():
        raise FileNotFoundError(args.tb_file)

    if args.error_tol <= 0:
        raise ValueError("error_tol must be positive.")
    if args.max_iter <= 0:
        raise ValueError("max_iter must be positive.")
    if args.refinement_factor < 1:
        raise ValueError("refinement_factor must be at least 1.")
    if args.t_min <= 0:
        raise ValueError("Temperature must be positive for df/da calculation.")


def resolve_ltb_use_custom_kmesh(executable: Path | None) -> Path:
    """Locate the ltb_use_custom_kmesh executable via explicit path, script directory, or PATH."""

    if executable is not None:
        candidate = executable.expanduser()
        if not candidate.exists():
            raise FileNotFoundError(candidate)
        if not os.access(candidate, os.X_OK):
            raise PermissionError(f"ltb_use_custom_kmesh at {candidate} is not executable.")
        return candidate.resolve()

    script_dir = Path(__file__).resolve().parent
    bundled = script_dir / "ltb_use_custom_kmesh"
    if bundled.exists():
        if not os.access(bundled, os.X_OK):
            raise PermissionError(f"ltb_use_custom_kmesh at {bundled} is not executable.")
        return bundled.resolve()

    discovered = shutil.which("ltb_use_custom_kmesh")
    if discovered:
        path = Path(discovered)
        if not os.access(path, os.X_OK):
            raise PermissionError(f"ltb_use_custom_kmesh at {path} is not executable.")
        return path.resolve()

    raise FileNotFoundError(
        "ltb_use_custom_kmesh executable not found. Provide --ltb_use_custom_kmesh, place it alongside ltb_refine_kmesh, or ensure it is on PATH."
    )


def run_ltb_use_custom_kmesh(args: argparse.Namespace, ltb_executable: Path, custom_mesh_path: Path, iteration: int) -> Path:
    workdir = args.workdir.resolve()
    workdir.mkdir(parents=True, exist_ok=True)

    command = [
        str(ltb_executable),
        str(args.tb_file.resolve()),
        str(custom_mesh_path.resolve()),
        "--filling",
        str(args.filling),
        "--mu",
        str(args.chemical_potential),
    ]
    if args.mushift:
        command.append("--mushift")

    logger.debug("Running ltb_use_custom_kmesh: %s", " ".join(command))
    subprocess.run(command, cwd=workdir, check=True)

    produced = workdir / "lrtc-tb-custom.hdf5"
    if not produced.exists():
        raise FileNotFoundError("ltb_use_custom_kmesh did not produce lrtc-tb-custom.hdf5")

    target_name = workdir / f"refined_iter_{iteration + 1}.hdf5"
    if target_name.exists() and not args.keep_intermediate:
        target_name.unlink()
    shutil.move(str(produced), str(target_name))
    return target_name


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO, format=LOG_FORMAT)

    try:
        ltb_executable = resolve_ltb_use_custom_kmesh(args.ltb_use_custom_kmesh)
        validate_inputs(args)
    except Exception as exc:  # pragma: no cover - CLI validation path
        logger.error("Input validation failed: %s", exc)
        return 1

    current_hdf5 = args.initial_hdf5.resolve()
    final_error: float | None = None

    previous_output: Path | None = None

    try:
        for iteration in range(args.max_iter):
            with h5py.File(current_hdf5, "r") as h5file:
                data: BandData = load_band_data(h5file)
                band_axis = build_band_axis(data.energies)

            try:
                final_error = compute_error(band_axis, args.t_min, args.gamma_min)
            except MissingDependencyError as exc:
                logger.error("%s", exc)
                return 1

            logger.info("Iteration %d: error = %.6f", iteration, final_error)
            if final_error <= args.error_tol:
                logger.info("Target error reached (%.6f <= %.6f).", final_error, args.error_tol)
                break

            try:
                hotspots, tolerance = detect_refinement_scale(
                    band_axis,
                    args.t_min,
                    args.gamma_min,
                    args.chemical_potential,
                    energy_window=args.energy_window,
                )
            except MissingDependencyError as exc:
                logger.error("%s", exc)
                return 1

            if tolerance == 0.0:
                logger.warning("No significant hotspots detected; stopping early.")
                break

            logger.debug("Hotspot count: %d, tolerance derived: %.6e", hotspots.size, tolerance)

            refined_points, refined_weights = refine_kmesh(
                data,
                target_energy=args.chemical_potential,
                tolerance=tolerance,
                refinement_factor=args.refinement_factor,
            )

            if refined_points.shape[0] == data.k_points.shape[0]:
                logger.warning("Refinement did not modify the mesh; stopping to avoid infinite loop.")
                break

            before_weight = np.sum(data.weights)
            after_weight = np.sum(refined_weights)
            if not np.allclose(before_weight, after_weight, rtol=1e-10, atol=1e-12):
                logger.warning(
                    "Weight conservation check failed: before=%s after=%s", before_weight, after_weight
                )

            mesh_path = args.workdir / f"custom_mesh_iter_{iteration + 1}.hdf5"
            if mesh_path.exists() and not args.keep_intermediate:
                mesh_path.unlink()
            write_custom_mesh(str(mesh_path), refined_points, refined_weights)

            try:
                current_hdf5 = run_ltb_use_custom_kmesh(args, ltb_executable, mesh_path, iteration)
            except subprocess.CalledProcessError as exc:
                logger.error("ltb_use_custom_kmesh failed: %s", exc)
                return exc.returncode or 1

            if not args.keep_intermediate:
                if mesh_path.exists():
                    mesh_path.unlink()
                if previous_output and previous_output.exists() and previous_output != current_hdf5:
                    previous_output.unlink()

            previous_output = current_hdf5

        else:
            logger.warning("Maximum iterations (%d) reached. Final error = %.6f", args.max_iter, final_error or float("nan"))

        logger.info("Refinement completed. Final mesh: %s", current_hdf5)
        return 0

    finally:
        logging.shutdown()


if __name__ == "__main__":  # pragma: no cover - CLI entry point
    sys.exit(main())
