#! /usr/bin/env python3
'''
ltb: Pre-processing of tight-binding structures for the LRTC code

Subcommands
-----------
  run        Build a regular k-mesh HDF5 file from a tight-binding model (default).
  refine     Iteratively refine an existing k-mesh towards a target error threshold.
  supercell  Create a periodic or finite supercell from a TB file.
  tb2xyz      Convert a TB file to XYZ format.

Usage
-----
  ltb run    tb_file nkx nky nkz filling [options]   # explicit
  ltb        tb_file nkx nky nkz filling [options]   # implicit run (backwards compatible)
  ltb refine initial.hdf5 tb_file mu gamma_min T_min [options]

Run 'ltb <subcommand> --help' for subcommand-specific options.
'''

import sys
from pathlib import Path

# Ensure the package root is on sys.path when invoked directly by path.
_root = Path(__file__).resolve().parent
if str(_root) not in sys.path:
    sys.path.insert(0, str(_root))

from scripts.ltb import run, refine_kmesh, supercell, tb2xyz

SUBCOMMANDS = {
    'run':       run,
    'refine':    refine_kmesh,
    'supercell': supercell,
    'tb2xyz':     tb2xyz,
}

HELP = '''ltb: Pre-processing of tight-binding structures for the LRTC code

Subcommands
-----------
  run        Build a regular k-mesh HDF5 file from a tight-binding model (default).
  refine     Iteratively refine an existing k-mesh towards a target error threshold.
  supercell  Create a periodic or finite supercell from a TB file.
  tb2xyz      Convert a TB file to XYZ format.

Usage
-----
  ltb run    tb_file nkx nky nkz filling [options]
  ltb        tb_file nkx nky nkz filling [options]   (backwards compatible)
  ltb refine initial.hdf5 tb_file mu gamma_min T_min [options]

Run 'ltb <subcommand> --help' for subcommand-specific options.
'''

def main():
    args = sys.argv[1:]

    if not args or args[0] in ('-h', '--help'):
        # Show the subcommand overview, then the default (run) help below it.
        print(HELP)
        print('--- ltb run (default) ---')
        sys.argv = ['ltb run', '--help']
        run.main(['--help'])
        sys.exit(0)

    if args and args[0] in SUBCOMMANDS:
        # Explicit subcommand: ltb run ... / ltb refine ...
        cmd, remaining = args[0], args[1:]
    else:
        # No subcommand given: default to 'run' for backwards compatibility.
        # ltb model.tb 3 3 1 2.0  ->  ltb run model.tb 3 3 1 2.0
        cmd, remaining = 'run', args

    sys.argv = [f'ltb {cmd}'] + remaining
    sys.exit(SUBCOMMANDS[cmd].main())

if __name__ == '__main__':
    main()
