begin hopping
  # rx ry rz orb1 orb2 hopping.real [hopping.imag]
  # on site hopping A-B-C
   0  0  0     1 2 1.3   # t + delta
   0  0  0     1 3 1.3
   0  0  0     3 1 1.3
   0  0  0     2 1 1.3
  +1  0  0     2 1 0.7   # t - delta
   0 +1  0     3 1 0.7
  -1  0  0     1 2 0.7
   0 -1  0     1 3 0.7
end hopping

begin atoms
  # sort rx, ry, rz
  1 0   0   0
  # to break symmetry
  2 0   0.4 0
  2 0.4 0   0
end atoms

begin orbitals # orbital section required for generalized Peierls substitution matrix elements.
  # orbital rx, ry, rz   (orbital 2 couples along x, orbital 3 along y)
  1 0   0   0   # A
  2 0.4 0   0   # B: short bond (t + delta) inside the cell
  3 0   0.4 0   # C: short bond (t + delta) inside the cell
end orbitals

begin real_lattice
  1 0 0
  0 1 0
  0 0 1
end real_lattice
