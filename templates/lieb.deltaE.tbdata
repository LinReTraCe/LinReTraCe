begin hopping
  # rx ry rz orb1 orb2 hopping.real [hopping.imag]
  # on site hopping A-B-C
  ## atom 2 and 3 are elevated in energy
   0  0  0     1 1 0.0  # E0
   0  0  0     2 2 1.0  # E0 + deltaE
   0  0  0     3 3 1.0  # E0 + deltaE
   0  0  0     1 2 1.0
   0  0  0     1 3 1.0
   0  0  0     3 1 1.0
   0  0  0     2 1 1.0
  +1  0  0     2 1 1.0
   0 +1  0     3 1 1.0
  -1  0  0     1 2 1.0
   0 -1  0     1 3 1.0
end hopping

begin atoms
  # sort rx, ry, rz
  1 0   0   0
  # to break symmetry
  2 0   0.4 0
  2 0.4 0   0
end atoms

begin orbitals # orbital section required for generalized Peierls substitution matrix elements.
  # orbital rx, ry, rz   (orbital 2 couples along x, orbital 3 along y)
  # equal hoppings: orbitals sit at the bond centres, independent of the
  # displaced atoms above (which only lower the symmetry)
  1 0   0   0   # A
  2 0.5 0   0   # B
  3 0   0.5 0   # C
end orbitals

begin real_lattice
  1 0 0
  0 1 0
  0 0 1
end real_lattice
