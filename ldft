#! /usr/bin/env python3

from __future__ import print_function, division, absolute_import
import argparse
import os
import sys
import logging

from structure.dftdetect import DftDetection
from structure.inout     import h5output
from structure.trunc     import truncate
from structure.trunc     import TruncationError
from structure.auxiliary import LogFormatter

try:
  from structure.boltztrap import BoltztrapInterpolation
  btp_exists = True
except ImportError:
  btp_exists = False

'''
ldft: Pre-processing of DFT codes for the LRTC code
'''

''' Explanation appended to `ldft --help`.  --optic, --interp and --mesh are
    routinely confused with one another, so the combinations are spelled out
    rather than left to be inferred from the individual help strings. '''
OPTICAL_ELEMENT_GUIDE = """
Where the optical elements come from
------------------------------------
  (neither flag)              no elements are written; the output file cannot
                              be used by lrtc
  --optic                     DFT dipole matrix elements, zero field only
  --interp                    Peierls elements (velocity squared) plus the
                              magnetic-field elements from the curvatures
  --optic --interp            DFT dipoles at zero field, interpolated
                              curvatures for the magnetic field.  This is the
                              most complete combination available, and the
                              only way to get both true matrix elements and
                              B-field quantities.  lrtc warns that the two
                              sources are being mixed.
  --optic --interp --peierls  interpolated elements only; --optic is read and
                              then discarded
  --interp --mesh NKX NKY NKZ everything re-evaluated on the requested mesh
  --optic --mesh ...          rejected: the DFT elements exist only on the
                              k-mesh they were computed on

--interp and --mesh are independent
-----------------------------------
--interp NSTARS sets the quality of the fit; --mesh sets the k-points it is
evaluated on.  Neither one changes the DFT calculation underneath.  If the
DFT mesh is too coarse, a finer --mesh only samples a poor fit more densely;
the hold-out validation that runs after --interp is there to tell you when
that is happening.
"""


def parse_args(args=None):
  parser = argparse.ArgumentParser(
    formatter_class=argparse.RawTextHelpFormatter,
    description='Argument parser for the DFT pre-processing of LRTC',
    epilog=OPTICAL_ELEMENT_GUIDE)
  parser.add_argument('system',     help='Path to DFT calculation (Wien2K Folder or Vasp Folder / vasprun.xml directly')
  parser.add_argument('-o', '--output',   help='Outputname of hdf5 (default="lrtc-dft.hdf5")', default='lrtc-dft.hdf5')
  parser.add_argument('--optic',    help='Read the optical (dipole) matrix elements produced by the DFT code\n'
                                         '(Wien2k: case.symmat). "x optic" must have been run with 3, 6 or 9\n'
                                         'directional components: Rexx Reyy Rezz [Rexy Rexz Reyz] [Imxy Imxz Imyz].\n'
                                         'These are true transition matrix elements and exist only on the k-mesh\n'
                                         'of the DFT calculation, so they cannot be moved to another mesh.',
                                    default=False, action='store_true')

  parser.add_argument('--trunc', nargs=2, help='Relative energy levels to include in the truncation. (relative to DFT chem. potential in [eV], e.g. -5 5)')
  parser.add_argument('--abs',   help='Absolute energy levels in trunc option. Must include Fermi level.', default=False, action='store_true')

  parser.add_argument('--interp',   nargs='?', metavar='NSTARS',
                                    help='Enable Fourier (star-function) interpolation of the band structure\n'
                                         'via BoltzTraP2.  NSTARS (default 3) is the number of star functions\n'
                                         'used per k-point of the DFT mesh.  It controls how flexible the fit\n'
                                         'is -- it does NOT change the density of any k-mesh, and --interp 3\n'
                                         'does not make the mesh three times finer.  Larger NSTARS costs time\n'
                                         'and memory; it cannot add accuracy beyond what the DFT mesh supports.\n'
                                         'Yields band velocities (Peierls optical elements, used when no DFT\n'
                                         'elements are present) and band curvatures, which are the only source\n'
                                         'of magnetic-field elements.',
                                    const=3, default=False, type=int)
  parser.add_argument('--mesh',     nargs=3, metavar=('NKX','NKY','NKZ'),
                                    help='Target k-mesh of the output file.  Requires --interp, because the new\n'
                                         'mesh is produced by evaluating the interpolation on it.  Re-samples\n'
                                         'the existing fit and therefore adds no information beyond what the\n'
                                         'DFT mesh already contains.  Cannot be combined with --optic.',
                                    default=None)
  parser.add_argument('--peierls',  help='Use the interpolated velocities as the optical elements even when DFT\n'
                                         'elements were read with --optic (i.e. discard the DFT elements).',
                                    default=False, action='store_true')
  parser.add_argument('--novalidate', help='Skip the hold-out validation of the interpolation (--interp).\n'
                                         'The validation costs one extra fit and reports the out-of-sample\n'
                                         'error of the interpolated energies near the chemical potential.',
                                    default=False, action='store_true')

  parser.add_argument('--debug',    help=argparse.SUPPRESS, default=False, action='store_true')
  return parser.parse_args(args)

class Program(object):
  '''
  Program class which executes the DFT read-in,
  BTP interpolation, Band truncation and output.
  '''

  def __init__(self, loglevel=1):
    '''
    Parse the arguments and define the input function (python 2/3 compatibility)
    and define the logger.
    '''
    self.args = parse_args()
    self.inputmethod = input if sys.version_info >= (3, 0) else raw_input
    self.setlogger(0 if self.args.debug else loglevel)

  def setlogger(self, value):
    '''
    Define a custom logger
    '''
    if value < 0: value = 0
    if value > 4: value = 4
    levels = [logging.DEBUG,logging.INFO,logging.WARNING,logging.ERROR,logging.CRITICAL]

    self.log = logging.getLogger()   # apparently this has to be empty
    self.log.setLevel(levels[value]) # the root logger should be set to DEBUG
                                     # it essentially sets a lower limit for all the handlers
    # configure the console stream
    console = logging.StreamHandler()
    console.setFormatter(LogFormatter())
    console.setLevel(levels[value])
    self.log.addHandler(console)

    # configure the file stream
    # fileh   = logging.FileHandler('logfile.log')
    # fileh.setFormatter(logging.Formatter('%(asctime)s: %(name)s: %(message)s'))
    # fileh.setLevel(logging.WARNING)
    # self.log.addHandler(fileh)

  def main(self):
    '''
    Check for existance of the provided file.
    Define the DFT calculation.
    optional: Interpolate the band-structure
    optional: Truncate the band-structure
    Output everything to HDF5
    '''

    # option check
    if self.args.abs and self.args.trunc is None:
      self.log.error('--abs requires --truncate')
      return

    if self.args.interp and not btp_exists:
      self.log.error('Interpolation option requires BoltzTrap2')
      return

    ''' --mesh is only consumed inside the interpolation; without --interp it
        was previously accepted and silently ignored, producing an output file
        on the original mesh with no indication that anything was skipped. '''
    if self.args.mesh and not self.args.interp:
      self.log.error('--mesh requires --interp (the new mesh is generated by the interpolation).')
      return

    ''' checked here rather than after the interpolation: the combination is
        rejected either way, and the user should not have to wait for a fit
        that is about to be thrown away. '''
    if self.args.mesh and self.args.optic and not self.args.peierls:
      self.log.error('--mesh cannot be combined with --optic: the DFT optical elements exist\n'
                     'only on the k-mesh they were computed on. Drop --optic to use the\n'
                     'interpolated (Peierls) elements on the new mesh, or add --peierls to\n'
                     'read the DFT elements and then discard them.')
      return

    # DFT detection + read-in
    dftsearch = DftDetection(self.args.system)
    dftdict = dftsearch()
    if dftdict is None:
      self.log.error('Could not detect supported DFT calculation in provided path.')
      return
    dftclass = dftdict.pop('dft')

    # check if output file exists
    if os.path.isfile(self.args.output):
      print('Output file already exists!')
      overwrite = self.inputmethod('Overwrite? (yes/no) ').strip().lower()
      if overwrite not in ['y','yes']:
        self.log.info('File will not be overwritten.\nExiting.')
        return

    calc = dftclass(self.args.system, optic=self.args.optic, **dftdict)
    calc.readData()

    # Band interpolation via BTP2
    if self.args.interp:
      self.log.info('')
      try:
        btinterp = BoltztrapInterpolation(calc)
        btinterp.interpolate(self.args.interp, self.args.mesh)
        if not self.args.novalidate:
          btinterp.validate()
      except Exception as e:
        btinterp = None
        logging.disable(logging.NOTSET)
        ''' the exception used to be captured and discarded, which hid the
            actual cause (out of memory, unsupported numpy, ...) behind a
            generic message and produced a plausible looking output file on
            the *original* mesh. '''
        self.log.warning('Error in BoltzTrap2 interpolation: {}: {}'.format(type(e).__name__, e))
        if self.args.debug:
          self.log.exception('Traceback of the interpolation failure:')
        if self.args.mesh:
          self.log.warning('The requested mesh {} was NOT applied; '
                           'output will use the original k-mesh.'.format(' '.join(self.args.mesh)))
        self.log.warning('Continuing without interpolation data.\n')
    else:
      btinterp = None

    # Update mesh of the ElectronicStructure
    if btinterp is not None and self.args.mesh:
      if self.args.optic and not self.args.peierls:
        raise IOError('Cannot use updated mesh with optics data.\n\nDisable --optic.')
      calc.energies     = btinterp.energies
      calc.nkp          = btinterp.nkp
      calc.nkx          = btinterp.nkx
      calc.nky          = btinterp.nky
      calc.nkz          = btinterp.nkz
      calc.nsym         = btinterp.nsym
      calc.symop        = btinterp.symop
      calc.invsymop     = btinterp.invsymop
      calc.irreducible  = btinterp.irreducible
      calc.kpoints      = btinterp.kpoints
      calc.weights      = btinterp.weights
      calc.multiplicity = btinterp.multiplicity
      self.log.info('Updated momentum mesh:')
      self.log.info('  Number of k-points: {}'.format(calc.nkp))
      self.log.info('  Mesh: {} {} {}'.format(calc.nkx, calc.nky, calc.nkz))
      self.log.info('  Irreducible: {}'.format(calc.irreducible))
      self.log.info('  Mesh shift: {}'.format(calc.kshift))
      self.log.info('Updating chemical potential.')
      calc._calcFermiLevel()

    # Band truncation
    if self.args.trunc:
      self.log.info('')
      try:
        truncate(calc, btinterp, float(self.args.trunc[0]), \
                                 float(self.args.trunc[1]), absolute=self.args.abs)
      except TruncationError as e:
        self.log.exception(str(e))
        self.log.warning('Continuing without truncation.')

    # Data output
    self.log.info('')
    h5output(self.args.output, calc, btinterp, self.args.peierls)

    print("Output file {!r} successfully created.".format(self.args.output))
    print("File size: {} MB.".format(os.stat(self.args.output).st_size/1000000))

  def cleanup(self):
    if os.path.isfile(self.args.output):
      os.remove(self.args.output)

  def run(self):
    try:
      self.main()
    except KeyboardInterrupt:
      self.log.info('User exit ...')
    except MemoryError:
      self.log.exception('Memory error: Initialized arrays require too much memory.')
    except Exception as e:
      self.log.exception(str(e))

if __name__ == '__main__':
  Program(loglevel=1).run()
